---
/**
 * 「準備中」の表示。中身がまだないページで、一覧などの代わりに置く。
 * 跳ねるボールと点滅する「Coming soon」で、ゲームの読み込み画面のように見せる。
 */
interface Props {
	/** 下に添える説明文 */
	message?: string;
}

const { message = "このページは準備中です。公開まで、もうしばらくお待ちください。" } = Astro.props;
---

<tt-coming-soon>
	<div class="tt-coming-soon__body panel">
		<div class="bounce-ball" aria-hidden="true"></div>
		<p class="display-title blink">Coming soon</p>
		<p class="tt-coming-soon__message">{message}</p>
	</div>
</tt-coming-soon>
