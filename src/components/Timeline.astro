---
/**
 * 年ごとにまとめた時系列の一覧（戦績、卓球歴など）。日付順に並べ替えて表示する。
 *   badge     … 結果などを表示するバッジ（例: '優勝'）
 *   highlight … true でコインとバッジを金色にする
 */
interface TimelineItem {
	/** 'YYYY-MM-DD' / 'YYYY-MM' / 'YYYY' */
	date: string;
	title: string;
	note?: string | null;
	badge?: string | null;
	highlight?: boolean | null;
}

interface Props {
	items: TimelineItem[];
	/** "asc" で古い順（既定は新しい順） */
	order?: "asc" | "desc";
	/** 表示件数の上限（並べ替え後の先頭から） */
	limit?: number;
}

const { items, order = "desc", limit = Infinity, ...attrs } = Astro.props;
const direction = order === "asc" ? 1 : -1;
const sorted = items.toSorted((a, b) => a.date.localeCompare(b.date) * direction).slice(0, limit);
const groups = Map.groupBy(sorted, (item) => item.date.slice(0, 4));
const hasBadge = sorted.some((item) => item.badge);

// '2026-08-24' → '8.24' / '2026-08' → '8月' / '2026' → ''（年は見出しに出る）
function formatMonthDay(date: string) {
	const [, month, day] = date.split("-").map(Number);
	if (!month) return "";
	return day ? `${month}.${day}` : `${month}月`;
}
---

<tt-timeline {...attrs}>
	<ol class:list={["tt-timeline__groups", { "tt-timeline__groups--no-badge": !hasBadge }]}>
		{
			[...groups].map(([year, entries]) => (
				<li class="tt-timeline__group">
					<h3 class="tt-timeline__year">{year}</h3>
					<ol class="tt-timeline__entries">
						{entries.map((item) => (
							<li class:list={["tt-timeline__entry", { "is-highlight": item.highlight }]}>
								<time class="tt-timeline__date" datetime={item.date}>
									{formatMonthDay(item.date)}
								</time>
								<div class="tt-timeline__body">
									<p class="tt-timeline__title">{item.title}</p>
									{item.note && <p class="tt-timeline__note">{item.note}</p>}
								</div>
								{item.badge && <p class="tt-timeline__badge">{item.badge}</p>}
							</li>
						))}
					</ol>
				</li>
			))
		}
	</ol>
</tt-timeline>
