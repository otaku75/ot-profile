---
/**
 * サイト共通フッター。SNS は content/site.yaml の social に書いたものだけを表示する。
 */
interface Props {
	name: string;
	/** サービスごとのアカウント名か URL（空のものは出さない） */
	social?: { instagram?: string | null; x?: string | null; youtube?: string | null } | null;
}

const { name, social } = Astro.props;

// アカウント名（@ はあってもなくてもよい）なら URL を組み立てる。URL ならそのまま使う
const SERVICES: { key: keyof NonNullable<Props["social"]>; label: string; url: (handle: string) => string }[] = [
	{ key: "instagram", label: "Instagram", url: (handle: string) => `https://www.instagram.com/${handle}/` },
	{ key: "x", label: "X", url: (handle: string) => `https://x.com/${handle}` },
	{ key: "youtube", label: "YouTube", url: (handle: string) => `https://www.youtube.com/@${handle}` },
];

const links = SERVICES.flatMap(({ key, label, url }) => {
	const value = social?.[key]?.trim();
	if (!value) return [];
	return [{ label, href: /^https?:\/\//.test(value) ? value : url(value.replace(/^@/, "")) }];
});
const year = new Date().getFullYear();
---

<tt-footer class="theme-dark">
	<div class="tt-footer__inner container">
		<p class="tt-footer__name">{name}</p>
		{
			links.length > 0 && (
				<ul class="tt-footer__social">
					{links.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			)
		}
		<p class="tt-footer__copyright"><small>&copy; {year} {name}</small></p>
	</div>
</tt-footer>
