---
/**
 * 能力値の一覧。値を丸いドットの数で表すゲームのステータス風の表示。
 * 画面に入ったときに revealed 属性を付け、ドットが順に埋まる演出をする（下の <script>）。
 */
interface Props {
	items: { label: string; value: number }[];
	/** 最大値＝ドットの数（既定 10） */
	max?: number;
}

const { items, max = 10 } = Astro.props;
const clamp = (value: number) => Math.min(Math.max(Number(value) || 0, 0), max);
---

<tt-stat-list>
	<ul class="tt-stat-list__list">
		{
			items.map((stat) => {
				const value = clamp(stat.value);
				return (
					<li class="tt-stat-list__item">
						<span class="tt-stat-list__label">{stat.label}</span>
						<span
							class="tt-stat-list__meter"
							role="meter"
							aria-label={stat.label}
							aria-valuemin="0"
							aria-valuemax={max}
							aria-valuenow={value}
						>
							{Array.from({ length: max }, (_, i) => (
								<span class:list={["tt-stat-list__pip", { "is-filled": i < value }]} style={`--i: ${i}`} />
							))}
						</span>
						<span class="tt-stat-list__value" aria-hidden="true">
							{value}
						</span>
					</li>
				);
			})
		}
	</ul>
</tt-stat-list>

<script>
	class TtStatList extends HTMLElement {
		#observer: IntersectionObserver | null = null;

		connectedCallback() {
			if (this.hasAttribute("revealed")) return;
			this.#observer = new IntersectionObserver(
				(entries) => {
					if (!entries.some((entry) => entry.isIntersecting)) return;
					this.setAttribute("revealed", "");
					this.#observer?.disconnect();
				},
				{ threshold: 0.3 },
			);
			this.#observer.observe(this);
		}

		disconnectedCallback() {
			this.#observer?.disconnect();
		}
	}

	customElements.define("tt-stat-list", TtStatList);
</script>
