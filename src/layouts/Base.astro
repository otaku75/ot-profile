---
/**
 * 全ページ共通のレイアウト。<head>（SEO・SNS シェア用の meta を含む）、ヘッダー、フッターをまとめる。
 * サイト名・説明文・SNS は content/site.yaml、名前は content/profile.md から読む。
 */
import "../styles/main.css";
import { getImage } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getProfile, getSite } from "../lib/content";
import { pagePath } from "../lib/path";

interface Props {
	/** ページ名（省略するとサイト名だけになる） */
	title?: string;
	/** 省略すると content/site.yaml の description */
	description?: string;
	/** <body> に付けるクラス（404 ページの theme-dark など） */
	bodyClass?: string;
	/** フッターを出すか */
	footer?: boolean;
	/** 検索結果に出さない（404 ページなど） */
	noindex?: boolean;
}

const { title, description, bodyClass, footer = true, noindex = false } = Astro.props;
const [site, profile] = await Promise.all([getSite(), getProfile()]);
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const pageDescription = description ?? site.description;
const name = profile.data.name_en;

// canonical と、シェアされたときの画像（トップの写真）は絶対 URL が要るので、
// 公開先の URL（astro.config.mjs の site）を設定したときだけ出す
const canonical = Astro.site && !noindex ? new URL(pagePath(Astro.url), Astro.site).href : undefined;
const heroImage = profile.data.hero_image;
const ogImage =
	Astro.site && heroImage
		? new URL((await getImage({ src: heroImage.src, width: 1200, format: "jpg", layout: "none" })).src, Astro.site).href
		: undefined;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={pageDescription} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:title" content={title ?? site.title} />
		<meta property="og:description" content={pageDescription} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Zen+Maru+Gothic:wght@500;700&display=swap"
		/>
	</head>
	<body class={bodyClass}>
		<Header name={name} />
		<slot />
		{footer && <Footer name={name} social={site.social} />}
	</body>
</html>
