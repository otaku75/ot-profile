---
// お知らせページ。内容は content/news.yaml
import ComingSoon from "../components/ComingSoon.astro";
import NewsList from "../components/NewsList.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { getNews, isComingSoon } from "../lib/content";

const [news, comingSoon] = await Promise.all([getNews(), isComingSoon("news")]);
---

<Base title="お知らせ" noindex={comingSoon}>
	<main>
		<section class="section section--page-top" id="news">
			<div class="container">
				<PageHeader en="News" ja="お知らせ・試合予定" />
				{
					comingSoon ? (
						<ComingSoon />
					) : (
						<div class="panel">
							<NewsList items={news} />
						</div>
					)
				}
			</div>
		</section>
	</main>
</Base>
