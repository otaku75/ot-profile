---
// スポンサーページ。内容は content/sponsor.yaml
import ComingSoon from "../components/ComingSoon.astro";
import PageHeader from "../components/PageHeader.astro";
import SponsorList from "../components/SponsorList.astro";
import Base from "../layouts/Base.astro";
import { getSponsors, isComingSoon } from "../lib/content";

const [sponsors, comingSoon] = await Promise.all([getSponsors(), isComingSoon("sponsor")]);
---

<Base title="スポンサー" noindex={comingSoon}>
	<main>
		<section class="section section--page-top" id="sponsor">
			<div class="container flow flow--lg">
				<PageHeader en="Sponsor" ja="スポンサー" />
				{
					comingSoon ? (
						<ComingSoon />
					) : (
						<>
							<SponsorList sponsors={sponsors} />
						</>
					)
				}
			</div>
		</section>
	</main>
</Base>
