---
// 戦績ページ。内容は content/results.yaml
import PageHeader from "../components/PageHeader.astro";
import Timeline from "../components/Timeline.astro";
import Base from "../layouts/Base.astro";
import { getResults } from "../lib/content";

const results = await getResults();
---

<Base title="戦績">
	<main>
		<section class="section section--page-top" id="results">
			<div class="container">
				<PageHeader en="Results" ja="戦績" />
				<div class="panel">
					<Timeline items={results} />
				</div>
			</div>
		</section>
	</main>
</Base>
