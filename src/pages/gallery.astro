---
// ギャラリーページ（写真＋YouTube 動画）。内容は content/gallery.yaml
import ComingSoon from "../components/ComingSoon.astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import VideoList from "../components/VideoList.astro";
import Base from "../layouts/Base.astro";
import { getGallery, isComingSoon } from "../lib/content";

const [{ photos, videos }, comingSoon] = await Promise.all([getGallery(), isComingSoon("gallery")]);
---

<Base title="ギャラリー" noindex={comingSoon}>
	<main>
		<section class="section section--page-top" id="gallery">
			<div class="container flow flow--lg">
				<PageHeader en="Gallery" ja="ギャラリー" />
				{comingSoon && <ComingSoon />}
				{
					photos.length > 0 && (
						<div class="flow flow--md">
							<h2 class="eyebrow">Photo</h2>
							<PhotoGallery photos={photos} />
						</div>
					)
				}
				{
					videos.length > 0 && (
						<div class="flow flow--md">
							<h2 class="eyebrow">Movie</h2>
							<VideoList videos={videos} />
						</div>
					)
				}
			</div>
		</section>
	</main>
</Base>
