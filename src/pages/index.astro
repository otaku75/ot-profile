---
// トップページ（タイトル画面）。ヒーローと、各ページへのメニューだけを置く
import Hero from "../components/Hero.astro";
import Menu from "../components/Menu.astro";
import { nav } from "../data/site";
import Base from "../layouts/Base.astro";
import { formatDate, getComingSoonPages, getNews, getProfile, getResults } from "../lib/content";

const [profile, results, news, comingSoon] = await Promise.all([
	getProfile(),
	getResults(),
	getNews(),
	getComingSoonPages(),
]);

// 戦績・お知らせのカードには、説明文の代わりに最新の1件を添える（ほかの項目と、まだ1件もないときは src/data/site.ts の説明文）
const [latestResult] = results;
const [latestNews] = news;
const previews: Record<string, string | undefined> = {
	results: latestResult && `最新: ${latestResult.title} ${latestResult.badge ?? ""}`.trim(),
	news: latestNews && `${formatDate(latestNews.date)} ${latestNews.title}`,
};
// 中身がまだないページは「Coming soon」の表示にする
const items = nav.map((item) => ({
	...item,
	preview: previews[item.id] || item.description,
	comingSoon: comingSoon.has(item.id),
}));
---

<Base>
	<main>
		<Hero
			framed
			image={profile.data.hero_image}
			eyebrow={profile.data.label}
			heading={profile.data.name_en}
			subheading={profile.data.name_ja}
		/>
		<nav class="section section--flush-top" aria-label="メニュー">
			<div class="container">
				<Menu items={items} />
			</div>
		</nav>
	</main>
</Base>
