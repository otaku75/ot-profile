---
// お問い合わせページ。連絡先のメールアドレスはプロフィールで編集する
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { getProfile } from "../lib/content";

const email = (await getProfile())?.data.contact_email;
---

<Base title="お問い合わせ">
	<main>
		<section class="section section--page-top" id="contact">
			<div class="container">
				<PageHeader en="Contact" ja="お問い合わせ" />
				<div class="panel measure flow flow--md">
					<p>取材・イベント出演・スポンサーシップに関するご相談は、下記よりお気軽にご連絡ください。</p>
					{
						email ? (
							<p>
								<a class="button" href={`mailto:${email}`}>
									メールで問い合わせる
								</a>
							</p>
						) : (
							<p class="caption">※ 現在、お問い合わせ先を準備中です。</p>
						)
					}
					{email && <p class="caption">※ 内容を確認のうえ、折り返しご連絡いたします。</p>}
				</div>
			</div>
		</section>
	</main>
</Base>
