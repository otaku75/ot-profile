{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-profile",
	"compatibility_date": "2026-02-24",
	// npm run build で作った dist/ の静的ファイルをそのまま配信する（Worker のコードはない）
	"assets": {
		"directory": "./dist",
		// 存在しない URL では dist/404.html（GAME OVER）を 404 で返す
		"not_found_handling": "404-page",
	},
}
