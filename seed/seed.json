{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "My Profile",
    "description": "卓球プレーヤー 太田輝のポートフォリオサイト",
    "author": "Hikaru Ota"
  },
  "settings": {
    "title": "Hikaruのポートフォリオ",
    "tagline": "卓球プレーヤー 太田輝のポートフォリオ。プロフィール、戦績、ギャラリーなどを掲載しています。"
  },
  "collections": [
    {
      "slug": "profile",
      "label": "プロフィール",
      "labelSingular": "プロフィール",
      "description": "名前・写真・自己紹介・能力値・そうび・卓球歴など。1件だけ作り、サイト全体で使います。",
      "icon": "user",
      "sortOrder": 1,
      "routable": false,
      "supports": [
        "drafts",
        "revisions"
      ],
      "titleField": "name_en",
      "admin": {
        "quickCreate": false
      },
      "fields": [
        {
          "slug": "name_en",
          "label": "名前（英字）",
          "type": "string",
          "required": true
        },
        {
          "slug": "name_ja",
          "label": "名前（日本語）",
          "type": "string",
          "required": true
        },
        {
          "slug": "label",
          "label": "肩書き",
          "type": "string"
        },
        {
          "slug": "hero_image",
          "label": "トップページの写真",
          "type": "image"
        },
        {
          "slug": "photo",
          "label": "プロフィール写真",
          "type": "image"
        },
        {
          "slug": "bio",
          "label": "自己紹介",
          "type": "portableText"
        },
        {
          "slug": "facts",
          "label": "基本情報",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "label",
                "label": "項目",
                "type": "string",
                "required": true
              },
              {
                "slug": "value",
                "label": "内容",
                "type": "string",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "abilities",
          "label": "能力値（0〜10の自己評価）",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "label",
                "label": "項目",
                "type": "string",
                "required": true
              },
              {
                "slug": "value",
                "label": "値（0〜10）",
                "type": "integer",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "equipment",
          "label": "そうび（使用用具）",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "slot",
                "label": "種類（例: ラケット）",
                "type": "string",
                "required": true
              },
              {
                "slug": "name",
                "label": "名前",
                "type": "string",
                "required": true
              },
              {
                "slug": "maker",
                "label": "メーカー",
                "type": "string"
              },
              {
                "slug": "comment",
                "label": "ひとこと",
                "type": "text"
              },
              {
                "slug": "image",
                "label": "写真",
                "type": "image"
              }
            ]
          }
        },
        {
          "slug": "history",
          "label": "卓球歴",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "date",
                "label": "年月（例: 2012 / 2014-08 / 2014-08-20）",
                "type": "string",
                "required": true
              },
              {
                "slug": "title",
                "label": "できごと",
                "type": "string",
                "required": true
              },
              {
                "slug": "note",
                "label": "補足",
                "type": "string"
              },
              {
                "slug": "highlight",
                "label": "金色で強調する",
                "type": "boolean"
              }
            ]
          }
        },
        {
          "slug": "contact_email",
          "label": "お問い合わせ先メールアドレス",
          "type": "string"
        }
      ]
    },
    {
      "slug": "results",
