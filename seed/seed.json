        {
          "slug": "title",
          "label": "大会名",
          "type": "string",
          "required": true
        },
        {
          "slug": "date",
          "label": "日付（例: 2026-08-24。日がわからなければ 2026-08）",
          "type": "string",
          "required": true,
          "validation": {
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          }
        },
        {
          "slug": "note",
          "label": "種目",
          "type": "string"
        },
        {
          "slug": "badge",
          "label": "結果（例: 優勝）",
          "type": "string"
        },
        {
          "slug": "highlight",
          "label": "金色で強調する",
          "type": "boolean"
        }
      ]
    },
    {
      "slug": "news",
      "label": "お知らせ",
      "labelSingular": "お知らせ",
      "description": "お知らせ。日付の新しい順に表示されます。",
      "icon": "megaphone",
      "sortOrder": 3,
      "routable": false,
      "supports": [
        "drafts"
      ],
      "titleField": "title",
      "admin": {
        "listColumns": [
          "date",
          "category"
