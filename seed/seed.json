        {
          "slug": "image",
          "label": "写真",
          "type": "image",
          "required": true
        },
        {
          "slug": "sort",
          "label": "並び順（小さいほど先）",
          "type": "integer"
        }
      ]
    },
    {
      "slug": "videos",
      "label": "動画",
